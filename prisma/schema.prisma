generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Diagram {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String
  tags        String[]
  folder      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
